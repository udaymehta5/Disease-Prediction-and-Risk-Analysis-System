# ==============================================================
# Disease Prediction & Risk Analysis - Unified Backend & ML Engine
# Copy these environment variables into your Render Web Service
# ==============================================================

# Application Port (Render automatically sets PORT)
PORT=5000

# Frontend URL for CORS (e.g., https://your-frontend.vercel.app or * for wildcard)
CLIENT_URL=*

# Secret key for JWT user authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Supabase / PostgreSQL Connection String
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-xx.pooler.supabase.com:5432/postgres

# Groq Cloud API Key (Free from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq LLM Model (Default: qwen/qwen3.8-27b)
GROQ_MODEL=qwen/qwen3.8-27b

# (Optional) External ML service URL - Leave blank or omit to use the built-in native Groq engine!
# ML_SERVICE_URL=
